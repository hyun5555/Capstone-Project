# ==============================
# CODEF 호출 설정 (선택 — 비워 두면 기본값)
# ==============================
# CODEF_ENV: prod(기본) = CODEF_API_HOST + SECOND_CODEF_CLIENT_* 키 / demo = CODEF_API_HOST_DEV + CODEF_CLIENT_* 키
CODEF_ENV=
# CODEF 개발가이드에서 확인한 값으로 바꿀 수 있음 (기본값은 코드에 있음)
CODEF_REGISTRY_PATH=
CODEF_BUILDING_PATH=
CODEF_REGISTRY_ORGANIZATION=
CODEF_TIMEOUT_SEC=

# ==============================
# 분석 데이터 소스
# ==============================
# sample(기본): 샘플 JSON 재생 / codef: CODEF 실조회
ANALYSIS_DATA_SOURCE=sample
CODEF_SAMPLE_DIR=

# ==============================
# 근거 기반 설명 (RAG) 튜닝. 값은 python -m evaluation 으로 비교해서 정한다.
# ==============================
# 검색 전략: plain(가까운 순 Top-K) / balanced(등기부와 건축물대장 청크를 각각 하나 이상 포함) / adaptive(balanced + 항목별 Top-K)
RETRIEVAL_STRATEGY=adaptive
# 설명 프롬프트 버전: v1(기준선) / v2(역할, 조건, 예시, 검증)
EXPLAIN_PROMPT_VERSION=v2
# 현재 모델은 1 만 허용한다
LLM_TEMPERATURE=1
PDF_ANALYSIS_CONCURRENCY=2
PDF_ANALYSIS_TIMEOUT_SEC=180
